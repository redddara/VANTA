# Copy this file to .env.local and fill in the values from your Supabase project.
# Supabase dashboard > Project Settings > API
#
# Both are safe to expose in the browser. The anon key only grants what your RLS
# policies allow, which is why this app has no service-role key at all.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. Only needed if you serve the portal on a custom domain, so the
# Discord OAuth redirect points at the right origin. On Vercel without a custom
# domain this is detected automatically.
# NEXT_PUBLIC_SITE_URL=https://vanta.example.com

# Required. Discord snowflake for the crew server — only members of this guild
# can finish signing in. Enable Developer Mode in Discord → right-click the
# server icon → Copy Server ID.
DISCORD_GUILD_ID=your-discord-server-id

# Optional. Invite link shown when someone signs in but is not in the guild.
# NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.gg/your-invite

# Only used by `supabase start` for local development against Docker.
# The hosted project reads its Discord credentials from the dashboard instead.
# SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=
